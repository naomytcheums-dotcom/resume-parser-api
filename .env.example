# Empty LLM_BASE_URL = OpenAI. For a free OpenAI-compatible provider:
# Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/  (model: gemini-flash-latest)
# Groq          : https://api.groq.com/openai/v1                            (model: llama-3.3-70b-versatile)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Optional: require callers to send this value in an X-API-Key header.
# Leave empty to make the API open (no auth) — fine for a demo, not for
# production.
API_ACCESS_KEY=

# Accepts a single origin ("*"), a comma-separated list, or a JSON array —
# all formats are parsed safely.
CORS_ORIGINS=*
